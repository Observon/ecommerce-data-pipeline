# Local PostgreSQL connection used by the warehouse load stage.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_dw
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change_me

# Optional AWS configuration. Leave unset while running the local MVP.
AWS_REGION=us-east-1
S3_BUCKET=
S3_RAW_PREFIX=raw
S3_PROCESSED_PREFIX=processed
